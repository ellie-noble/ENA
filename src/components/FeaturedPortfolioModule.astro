---
import { getCollection } from "astro:content";
import PortfolioPost from '../components/PortfolioPost.astro'; 
import { Image } from "astro:assets"; 
import featuredIcon from '../assets/pink-heart-featured-179x179.png';

const featuredPortfolio1 = await getCollection("portfolio", ({ data }) => {
  return data.featured == "1";
});
const featuredPortfolio2 = await getCollection("portfolio", ({ data }) => {
  return data.featured == "2";
});
const featuredPortfolio3 = await getCollection("portfolio", ({ data }) => {
  return data.featured == "3";
});
const featuredPortfolio4 = await getCollection("portfolio", ({ data }) => {
  return data.featured == "4";
});
---

<div id="portfolio" class="content">
    <h4 style="visibility:hidden">Featured Portfolio</h4>
        <ul class="portfolio-cards">
          
          {
            featuredPortfolio1.map((portfolio) => (
                <li>
                  <div class="featured-folio-image">
                    <Image src= {featuredIcon} alt="featured" class="featured-heart" style="width:6%;height:auto" />
                <a href= {`/portfolio/${portfolio.id}/`}> <Image src={portfolio.data.cover} alt={portfolio.data.coverAlt} width="776" /></a>
                  </div>
             <PortfolioPost medium={portfolio.data.medium} submedium={portfolio.data.submedium} url={`/portfolio/${portfolio.id}/`} title={portfolio.data.title} />
             </li>
             
            ))
          }
          {
            featuredPortfolio2.map((portfolio) => (
                <li>
                  <div class="featured-folio-image">
                    <Image src= {featuredIcon} alt="featured" class="featured-heart" style="width:6%;height:auto" />
                <a href= {`/portfolio/${portfolio.id}/`}> <Image src={portfolio.data.cover} alt={portfolio.data.coverAlt} width="776" /></a>
             <PortfolioPost medium={portfolio.data.medium} submedium={portfolio.data.submedium} url={`/portfolio/${portfolio.id}/`} title={portfolio.data.title} />
                  </div>
             </li>
             
            ))
          }
          {
            featuredPortfolio3.map((portfolio) => (
                <li>
                  <div class="featured-folio-image">
                    <Image src= {featuredIcon} alt="featured" class="featured-heart" style="width:6%;height:auto" />
                <a href= {`/portfolio/${portfolio.id}/`}> <Image src={portfolio.data.cover} alt={portfolio.data.coverAlt} width="776" /></a>
             <PortfolioPost medium={portfolio.data.medium} submedium={portfolio.data.submedium} url={`/portfolio/${portfolio.id}/`} title={portfolio.data.title} />
                  </div>
             </li>
             
            ))
          }
          <div class="featured-mobile-only">
          {
            featuredPortfolio4.map((portfolio) => (
                <li>
                 <div class="featured-folio-image">
                    <Image src= {featuredIcon} alt="featured" class="featured-heart" style="width:6%;height:auto" /> 
                <a href= {`/portfolio/${portfolio.id}/`}> <Image src={portfolio.data.cover} alt={portfolio.data.coverAlt} width="776" /></a>
             <PortfolioPost medium={portfolio.data.medium} submedium={portfolio.data.submedium} url={`/portfolio/${portfolio.id}/`} title={portfolio.data.title} />
                 </div>
             </li>
             ))
          }
          </div>
        </ul>
		</div>