---
import { getCollection } from "astro:content";
import PortfolioPost from '../components/PortfolioPost.astro'; 
import { Image } from "astro:assets"; 

const allPortfolio = await getCollection("portfolio");
---
<div id="portfolio" class="content">
        <ul class="portfolio-cards">
          
          {
            allPortfolio.map((portfolio) => (
                <li>
                <a href= {`/portfolio/${portfolio.id}/`}> <Image src={portfolio.data.cover} alt={portfolio.data.coverAlt} width="776" /></a>
             <PortfolioPost medium={portfolio.data.medium} submedium={portfolio.data.submedium} url={`/portfolio/${portfolio.id}/`} title={portfolio.data.title} />
             </li>
            ))
          }
        
          
        </ul>
		</div>