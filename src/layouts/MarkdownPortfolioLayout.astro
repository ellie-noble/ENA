---
import BaseLayout from './BaseLayout.astro'
import { Image } from 'astro:assets'

const { frontmatter } = Astro.props;

---
<BaseLayout pageTitle={frontmatter.title}>
<div class="markdown-portfolio-container">
{frontmatter.cover && (
      <Image 
        src={frontmatter.cover} 
        alt={`Cover image for ${frontmatter.title}`} 
        width={776}
        height={970}
        quality={100}
      />
    )}
<h1>{frontmatter.title}</h1>

<p><em><a href={`/medium/${frontmatter.medium}/`}>{frontmatter.medium}</a>/<a href={`/submedium/${frontmatter.submedium}/`}>{frontmatter.submedium}</a></em></p>
<p>{frontmatter.pubDate.toLocaleDateString()}</p>
<p><em>{frontmatter.description}</em></p>
<p>by: {frontmatter.author}</p>
<img src={frontmatter.image.url} width="300" alt={frontmatter.image.alt} />

<slot />
</div>
</BaseLayout>