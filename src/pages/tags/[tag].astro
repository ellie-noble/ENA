---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortfolioPost from '../../components/PortfolioPost.astro';

export async function getStaticPaths() {
  const allPortfolio = Object.values(import.meta.glob('../portfolio/*.md', { eager: true }));

  const uniqueTags = [...new Set(allPortfolio.map((portfolio: any) => portfolio.frontmatter.tags).flat())];

  return uniqueTags.map((tag) => {
    const filteredPortfolio = allPortfolio.filter((post: any) => post.frontmatter.tags.includes(tag));
    return {
      params: { tag },
      props: { portfolio: filteredPortfolio },
    };
  });
}

const { tag } = Astro.params;
const { portfolio } = Astro.props;

---
<BaseLayout pageTitle={tag}>
  <p>Work tagged with {tag}</p>
  <ul>
    {portfolio.map((portfolio: any) => <PortfolioPost url={portfolio.url} title={portfolio.frontmatter.title} />)}
  </ul>
</BaseLayout>