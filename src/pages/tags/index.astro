---
import BaseLayout from '../../layouts/BaseLayout.astro'
const allPortfolio = Object.values(import.meta.glob('../portfolio/*.md', { eager: true }));
const tags = [...new Set(allPortfolio.map((portfolio: any) => portfolio.frontmatter.tags).flat())];
const pageTitle = 'Tag Index'

---
<BaseLayout pageTitle={pageTitle}>
    <div>
        {tags.map((tag) => (
            <p><a href={`/tags/${tag}`}>{tag}</a></p>  
            ))}
    </div>
</BaseLayout>