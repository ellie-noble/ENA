---
import { getCollection } from "astro:content";
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortfolioPost from '../../components/PortfolioPost.astro';
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const allPortfolio = await getCollection("portfolio");
  const uniqueSubmedium = [...new Set(allPortfolio.map((portfolio) => portfolio.data.submedium).flat())];

  return uniqueSubmedium.map((submedium) => {
    const filteredPortfolio = allPortfolio.filter((portfolio) => 
      portfolio.data.submedium.includes(submedium)
    );
    return {
      params: { submedium },
      props: { portfolio: filteredPortfolio },
    };
  });
}

const { submedium } = Astro.params;
const { portfolio } = Astro.props;

---
<BaseLayout pageTitle={submedium}>
  <div id="portfolio" class="content">
  <p>Work in {submedium}</p>
  <ul class="portfolio-cards">

    {
        portfolio.map((portfolio) => (
        <li>
            <a href= {`/portfolio/${portfolio.id}/`}> <Image src={portfolio.data.cover} alt={portfolio.data.coverAlt} width="776" /></a>
            <PortfolioPost medium={portfolio.data.medium} submedium={portfolio.data.submedium} url={`/portfolio/${portfolio.id}/`} title={portfolio.data.title} />
        </li>
    ))
    }
  </ul>
  </div>
</BaseLayout>