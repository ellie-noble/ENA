---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogPost from '../components/BlogPost.astro';
import { Image } from "astro:assets";

const pageTitle = "The Lost Princess Diaries";
const allPosts = await getCollection("blog");
const renderedPosts = await Promise.all(
	allPosts.map(async (post) => {
		const { Content } = await render(post);
		return {...post, Content};
	})
);
---
<BaseLayout pageTitle={pageTitle} >
	
	<h2 style="display:none">The Lost Princess Diaries</h2>
	<div class="blog-container">
		<div class="content">
		<div class="blog-posts">
	<ul>
       {renderedPosts.map((post) => (
			<li>
				<a href= {`/posts/${post.id}/`}><Image src={post.data.cover} alt={post.data.coverAlt} width="1260" /></a>
			<BlogPost url={`/posts/${post.id}/`} title={post.data.title} description={post.data.description} pubDate={post.data.pubDate} />
			<div> <post.Content /></div>
			<hr />
			<p>by {post.data.author}</p>
			<br />
			</li>
		))
	}
    </ul>
	</div>
	</div>
	</div>

</BaseLayout>