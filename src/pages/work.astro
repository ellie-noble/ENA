---
import BaseLayout from '../layouts/BaseLayout.astro'
const allPortfolio = Object.values(import.meta.glob('./portfolio/*.md', { eager: true }));
const pageTitle = "Work";
---

<BaseLayout pageTitle={pageTitle}>
		<div id="portfolio" class="content">
		<h1>{pageTitle}</h1>
        <p>This will be my work home gallery, to which everything else will link eventually (i hope!!)</p>
        <ul>
          {allPortfolio.map((portfolio: any) => <li><a href={portfolio.url}>{portfolio.frontmatter.title}</a></li>)}
        </ul>
		</div>
</BaseLayout>