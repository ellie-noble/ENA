---
import { getCollection } from "astro:content";
import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioPost from '../components/PortfolioPost.astro'; 

const pageTitle = "Work";
const allPortfolio = await getCollection("portfolio");

---

<BaseLayout pageTitle={pageTitle}>
		<div id="portfolio" class="content">
		<h1>{pageTitle}</h1>
        <p>This will be my work home gallery, to which everything else will link eventually (i hope!!)</p>
        <ul>
          {
            allPortfolio.map((portfolio) => (
             <PortfolioPost url={`/portfolio/${portfolio.id}/`} title={portfolio.data.title} />
            ))
          }
        </ul>
		</div>
</BaseLayout>